# Copy this file to .env and fill in your own values.
# Base URL for REST calls (intercepted by MSW in dev/demo).
VITE_API_URL=/api
# Socket.IO endpoint (intercepted by the MSW socket.io binding in dev/demo).
VITE_WS_URL=/
# Network mocks: 'false' disables MSW. Keep enabled for dev and the demo build.
VITE_ENABLE_MOCKS=true
# Google OAuth 2.0 Web Client ID (Google Cloud Console -> OAuth 2.0 Client IDs).
# When empty/unset, the Google button shows a setup hint instead of running the OAuth flow.
VITE_GOOGLE_CLIENT_ID=
# Facebook Login App ID (Meta for Developers -> My Apps -> Settings -> Basic -> App ID).
# When empty/unset, the Facebook button shows a setup hint instead of running the OAuth flow.
VITE_FACEBOOK_APP_ID=
